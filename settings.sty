\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{settings}[2026/09/17 Shared settings for CV notes]

% Pass [plots] to pull in pgfplots; it costs ~0.25s per compile, so parts that
% contain no plots should load this package without the option.
\newif\ifnotesplots
\DeclareOption{plots}{\notesplotstrue}
\DeclareOption*{}
\ProcessOptions\relax

\usepackage{graphicx}
\usepackage[utf8]{inputenc}
\usepackage{amssymb, amsmath, amsfonts, mathtools} %Math Packages
\usepackage{booktabs, cellspace, float} %Table
\usepackage{enumitem}
\usepackage{multicol}
\usepackage{xcolor}
\usepackage[margin=0.2in]{geometry}
\usepackage[small]{titlesec}
\usepackage{nopageno}
\usepackage{hyperref}
\usepackage{bookmark}
\usepackage[font=footnotesize]{caption}
\hypersetup{
colorlinks=true,
linkcolor=purple,
urlcolor=cyan
}
\setlength{\skip\footins}{0.865pc}

\titleformat*{\subsubsection}{\footnotesize\bfseries}

\newcounter{notechapter}
\newcounter{notesection}[notechapter]
\newcounter{notesubsection}[notesection]

\newcommand{\NoteChapter}[1]{\vspace{2pt}\stepcounter{notechapter}\phantomsection\pdfbookmark[0]{Chapter \thenotechapter: #1}{notechapter.\thenotechapter}\addcontentsline{toc}{section}{Chapter \thenotechapter: #1}\noindent{\large\textbf{Chapter \thenotechapter: #1}}\par\noindent
\vspace{-3pt}}

\newcommand{\NoteSection}[1]{\vspace{12pt}\stepcounter{notesection}\phantomsection\pdfbookmark[1]{\thenotechapter.\thenotesection\ #1}{sec.\thenotechapter.\thenotesection}\addcontentsline{toc}{subsection}{\thenotechapter.\thenotesection\ #1}\noindent{\normalsize\bfseries\thenotechapter.\thenotesection\enspace#1}\par\vspace{6pt}}

\newcommand{\NoteSubsection}[1]{\vspace{4pt}\stepcounter{notesubsection}\phantomsection\pdfbookmark[2]{\thenotechapter.\thenotesection.\thenotesubsection\ #1}{subsec.\thenotechapter.\thenotesection.\thenotesubsection}\addcontentsline{toc}{subsubsection}{\thenotechapter.\thenotesection.\thenotesubsection\ #1}\noindent{\small\bfseries\thenotechapter.\thenotesection.\thenotesubsection\enspace#1}\par\vspace{4pt}}



\newcommand{\R}{\mathbb{R}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\C}{\mathbb{C}}

%Table Dimensions
\setlength\cellspacetoplimit{3pt}
\setlength\cellspacebottomlimit{3pt}
\setlength{\columnseprule}{0.4pt}
%\setlength{\columnsep}{0.5cm}



\setlength{\parindent}{0pt}

% enumerate indent
\setlist[enumerate]{leftmargin=2em}
\setlist[itemize]{leftmargin=2em}

\newcommand{\columnbreaknofill}{\vfill\null\columnbreak}

\ifnotesplots
  \RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% Shared style for the small plots used inside the two-column body.
\pgfplotsset{notesplot/.style={
    width=\linewidth, height=4.4cm,
    tick label style={font=\tiny},
    label style={font=\tiny},
    legend style={font=\tiny, draw=none, fill=none, row sep=-1pt},
    every axis plot/.append style={line width=0.7pt},
    grid=major, grid style={gray!25, line width=0.2pt},
    axis line style={gray!60},
}}
\fi

% Front/back matter shared by every part document.
% Usage: \begin{notes}{Part N: Title} ... chapters ... \end{notes}
\newenvironment{notes}[1]{%
  \begin{center}
    \Large{\textbf{#1}}
     \rule{\textwidth}{0.5pt}
  \end{center}
  \begin{multicols*}{2}
  \begin{footnotesize}
  \setcounter{tocdepth}{2}
  {\small\tableofcontents}
  \vspace{6pt}
  \vspace{4pt}
  \newpage
}{%
  \end{footnotesize}
  \end{multicols*}
}

\endinput
